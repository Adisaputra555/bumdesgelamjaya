RewriteEngine On

# Jangan rewrite untuk folder uploads
RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
RewriteRule ^ - [L]

# Rewrite lainnya untuk CI
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]


# Fix CORS untuk font dan file statis (woff, ttf, js, css)
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|css|js)$">
        Header set Access-Control-Allow-Origin "https://www.bumdesgelamjaya.xyz"
    </FilesMatch>
</IfModule>
